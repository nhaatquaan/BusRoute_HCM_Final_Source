# ==============================================================================
# BUSROUTE HCM - BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# 1. MongoDB Connection String (Atlas Cloud hoặc Local Community Server)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=BusRouteDB

# 2. Server Port & Node Environment
PORT=3000
NODE_ENV=development

# 3. JWT Secret Configuration
# LƯU Ý BẢO MẬT: Trong Production, JWT_SECRET bắt buộc phải là chuỗi ngẫu nhiên tối thiểu 32 ký tự.
# Tạo khóa ngẫu nhiên an toàn bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_generate_with_crypto_random_bytes_64

# 4. CORS Origins (Dành cho Production)
# FRONTEND_URL=https://your-frontend-domain.vercel.app
# CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# 5. AI Assistant Provider Configuration
# 'gemini'   -> Sử dụng Google Gemini API (yêu cầu GEMINI_API_KEY)
# 'ollama'   -> Sử dụng Ollama Local Server (http://127.0.0.1:11434)
# 'disabled' -> Chế độ dự phòng Heuristic Offline (Route Planner hoạt động 100% độc lập)
AI_PROVIDER=disabled
GEMINI_API_KEY=your_gemini_api_key_placeholder
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
