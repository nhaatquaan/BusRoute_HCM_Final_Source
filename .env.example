# ==============================================================================
# BUSROUTE HCM V2.0 - MASTER CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. MongoDB Configuration
# Local MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/BusRouteDB?retryWrites=true&w=majority
DB_NAME=BusRouteDB

# 2. Backend Server Configuration
PORT=3000
NODE_ENV=development
# LƯU Ý BẢO MẬT: Trong Production, JWT_SECRET bắt buộc phải là chuỗi ngẫu nhiên tối thiểu 32 ký tự.
# Tạo khóa ngẫu nhiên an toàn bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_generate_with_crypto_random_bytes_64

# CORS & Frontend Origins (Dành cho Production)
# FRONTEND_URL=https://your-frontend-domain.vercel.app
# CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# 3. AI Assistant Configuration
# Options: 'gemini' | 'ollama' | 'disabled'
AI_PROVIDER=disabled
# Khóa API Google Gemini (Tùy chọn nếu AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_placeholder
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# 4. Frontend Configuration
VITE_API_URL=http://localhost:3000
# Khi triển khai trên Vercel:
# VITE_API_URL=https://your-backend-domain.vercel.app
